+// PackageFileAliases returns each source file of a Go package under the
+// package's import path, such as example.com/m/pkg/file.go, paired with
+// the file's path on disk, sorted by the first. A file of a package built
+// from a directory whose path does not end in the import path, such as
+// a module replaced by a local directory, is otherwise found only by its
+// path on disk. A file of an external test package, pkg_test, is also
+// listed under pkg.
+func (bi *BinaryInfo) PackageFileAliases() [][2]string {
+	if bi.packageFileAliases != nil {
+		return bi.packageFileAliases
+	}
+	dir := func(file string) string {
+		return file[:max(strings.LastIndexAny(file, `/\`), 0)]
+	}
+	// The package's directory is that of the first of its functions.
+	dirs := map[*compileUnit]string{}
+	for i := range bi.Functions {
+		fn := &bi.Functions[i]
+		cu := fn.cu
+		if cu == nil || !cu.isgo || cu.lineInfo == nil || fn.Entry == 0 || cu.name == "main" {
+			continue
+		}
+		if _, ok := dirs[cu]; ok {
+			continue
+		}
+		if !strings.HasPrefix(fn.Name, cu.name+".") && !strings.HasPrefix(fn.Name, escapePackagePath(cu.name)+".") {
+			continue
+		}
+		if f, _ := bi.pcToLine(fn, fn.Entry); f != "" && !strings.HasPrefix(f, "<") {
+			dirs[cu] = dir(f)
+		}
+	}
+	aliases := [][2]string{}
+	for cu, d := range dirs {
+		pkgs := []string{cu.name}
+		if p, ok := strings.CutSuffix(cu.name, "_test"); ok {
+			pkgs = append(pkgs, p)
+		}
+		for _, fe := range cu.lineInfo.FileNames {
+			if dir(fe.Path) != d {
+				continue
+			}
+			for _, p := range pkgs {
+				aliases = append(aliases, [2]string{p + "/" + fe.Path[len(d)+1:], fe.Path})
+			}
+		}
+	}
+	slices.SortFunc(aliases, func(a, b [2]string) int { return cmp.Or(cmp.Compare(a[0], b[0]), cmp.Compare(a[1], b[1])) })
+	bi.packageFileAliases = slices.Compact(aliases)
+	return bi.packageFileAliases
+}
+
 // LookupGenericFunc returns a map that allows searching for instantiations of generic function by specifying a function name without type parameters.
 // For example the key "pkg.(*Receiver).Amethod" will find all instantiations of Amethod:
 //   - pkg.(*Receiver[.shape.int]).Amethod
