+// jmpTarget returns the target of in if it is an unconditional jump with
+// an immediate offset.
+func jmpTarget(arm64 bool, in *AsmInstruction) (uint64, bool) {
+	b := in.Bytes
+	switch {
+	case arm64 && len(b) == 4:
+		if w := binary.LittleEndian.Uint32(b); w&0xFC000000 == 0x14000000 {
+			return in.Loc.PC + uint64(signExtend(uint64(w&0x3FFFFFF), 26)*4), true
+		}
+	case !arm64 && len(b) == 2 && b[0] == 0xEB:
+		return in.Loc.PC + 2 + uint64(int64(int8(b[1]))), true
+	case !arm64 && len(b) == 5 && b[0] == 0xE9:
+		return in.Loc.PC + 5 + uint64(int64(int32(binary.LittleEndian.Uint32(b[1:])))), true
+	}
+	return 0, false
+}
