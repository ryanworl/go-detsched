diff --git a/pkg/proc/abiresults.go b/pkg/proc/abiresults.go
new file mode 100644
index 0000000..728ec00
--- /dev/null
+++ b/pkg/proc/abiresults.go
@@ -0,0 +1,190 @@
+package proc
+
+import (
+	"debug/dwarf"
+	"errors"
+	"fmt"
+	"reflect"
+
+	"github.com/go-delve/delve/pkg/dwarf/godwarf"
+	"github.com/go-delve/delve/pkg/dwarf/op"
+	"github.com/go-delve/delve/pkg/dwarf/reader"
+)
+
+// ErrResultOnStack is the error of a result RegABIResults cannot read:
+// the internal ABI passes it on the stack.
+var ErrResultOnStack = errors.New("the ABI returns this result on the stack, and optimized code does not say where")
+
+// RegABIResults reads the results of scope's function from the registers
+// in which Go's internal ABI (ABIInternal, register-based since Go 1.17)
+// returns them. It is for a scope stopped at a RET instruction of the
+// function, where the results are in those registers whatever the
+// function's debug information says: optimized code often has no
+// location for a result at its return ("empty OP stack"). It returns the
+// results in order, each with the name and type of its DWARF entry; one
+// the ABI passes on the stack has Unreadable set to ErrResultOnStack.
+// It works on amd64 and arm64. The results are loaded with cfg.
+//
+// The ABI assigns each result, in order, the next integer and floating
+// point registers its parts need, from the first register on: a
+// boolean, integer, pointer, channel, map or function takes one integer
+// register, a float one floating point register, a complex number two,
+// a string two integer registers, an interface two, a slice three, a
+// struct its fields', an array of one element its element's, and an
+// empty array none. A result that does not fit, or an array of more
+// elements, goes on the stack, and the next result goes on from the
+// registers that result would have started at. See
+// cmd/compile/abi-internal.md.
+func (scope *EvalScope) RegABIResults(cfg LoadConfig) ([]*Variable, error) {
+	bi := scope.BinInfo
+	var ints, floats []uint64
+	switch bi.Arch.Name {
+	case "amd64":
+		// RAX, RBX, RCX, RDI, RSI, R8-R11 and X0-X14, by DWARF number
+		ints = []uint64{0, 3, 2, 5, 4, 8, 9, 10, 11}
+		floats = dwarfRegRange(17, 15)
+	case "arm64":
+		// R0-R15 and F0-F15
+		ints = dwarfRegRange(0, 16)
+		floats = dwarfRegRange(64, 16)
+	default:
+		return nil, fmt.Errorf("results in registers are not supported on %s", bi.Arch.Name)
+	}
+	if !bi.regabi || scope.Fn == nil {
+		return nil, errors.New("not a function of the register-based ABI")
+	}
+	dwarfTree, err := scope.image().getDwarfTree(scope.Fn.offset)
+	if err != nil {
+		return nil, err
+	}
+	a := &abiAssign{ints: ints, floats: floats}
+	var results []*Variable
+	for _, entry := range reader.Variables(dwarfTree, scope.Fn.Entry, int(^uint(0)>>1), reader.VariablesSkipInlinedSubroutines) {
+		if isret, _ := entry.Val(dwarf.AttrVarParam).(bool); entry.Tag != dwarf.TagFormalParameter || !isret {
+			continue
+		}
+		name, typ, err := readVarEntry(entry.Tree, scope.image())
+		if err != nil {
+			return nil, err
+		}
+		ni, nf := a.ni, a.nf
+		a.pieces, a.off = nil, 0
+		if !a.value(typ) {
+			a.ni, a.nf = ni, nf
+			v := newVariable(name, 0, typ, bi, scope.Mem)
+			v.Flags |= VariableReturnArgument
+			v.Unreadable = ErrResultOnStack
+			results = append(results, v)
+			continue
+		}
+		cmem, err := newCompositeMemory(scope.Mem, bi.Arch, scope.Regs, a.pieces, typ.Size())
+		v := newVariable(name, fakeAddressUnresolv, typ, bi, scope.Mem)
+		if cmem != nil {
+			cmem.base = fakeAddressUnresolv
+			v = newVariable(name, cmem.base, typ, bi, cmem)
+		}
+		v.Flags |= VariableReturnArgument | VariableFakeAddress
+		if err != nil {
+			v.Unreadable = err
+		}
+		results = append(results, v)
+	}
+	loadValues(results, cfg)
+	return results, nil
+}
+
+func dwarfRegRange(first uint64, n int) []uint64 {
+	r := make([]uint64, n)
+	for i := range r {
+		r[i] = first + uint64(i)
+	}
+	return r
+}
+
+// abiAssign assigns the registers of one result, as pieces of its value.
+type abiAssign struct {
+	ints, floats []uint64 // the ABI's registers
+	ni, nf       int      // the next free ones
+	pieces       []op.Piece
+	off          int64 // the bytes of the value the pieces cover
+}
+
+func (a *abiAssign) value(t godwarf.Type) bool {
+	t = godwarf.ResolveTypedef(t)
+	size := t.Size()
+	kind := t.Common().ReflectKind
+	switch t.(type) {
+	case *godwarf.InterfaceType:
+		kind = reflect.Interface // whose DWARF entry has no kind
+	case *godwarf.PtrType:
+		kind = reflect.Pointer // unsafe.Pointer's has none
+	}
+	switch kind {
+	case reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr,
+		reflect.Pointer, reflect.UnsafePointer, reflect.Chan, reflect.Map, reflect.Func:
+		return a.reg(&a.ni, a.ints, size)
+	case reflect.Float32, reflect.Float64:
+		return a.reg(&a.nf, a.floats, size)
+	case reflect.Complex64, reflect.Complex128:
+		return a.reg(&a.nf, a.floats, size/2) && a.reg(&a.nf, a.floats, size/2)
+	case reflect.String, reflect.Slice, reflect.Interface, reflect.Struct:
+		var st *godwarf.StructType
+		switch t := t.(type) {
+		case *godwarf.StructType:
+			st = t
+		case *godwarf.StringType:
+			st = &t.StructType
+		case *godwarf.SliceType:
+			st = &t.StructType
+		case *godwarf.InterfaceType:
+			st, _ = godwarf.ResolveTypedef(t.Type).(*godwarf.StructType)
+		}
+		if st == nil {
+			return false
+		}
+		start := a.off
+		for _, f := range st.Field {
+			a.pad(start + f.ByteOffset)
+			if !a.value(f.Type) {
+				return false
+			}
+		}
+		a.pad(start + size)
+		return true
+	case reflect.Array:
+		at, ok := t.(*godwarf.ArrayType)
+		switch {
+		case !ok:
+			return false
+		case at.Count == 0:
+			return true
+		case at.Count == 1:
+			return a.value(at.Type)
+		}
+		return false
+	}
+	return false
+}
+
+// reg assigns the next of regs, at *n, to the next size bytes.
+func (a *abiAssign) reg(n *int, regs []uint64, size int64) bool {
+	if size == 0 {
+		return true
+	}
+	if *n >= len(regs) {
+		return false
+	}
+	a.pieces = append(a.pieces, op.Piece{Kind: op.RegPiece, Val: regs[*n], Size: int(size)})
+	*n++
+	a.off += size
+	return true
+}
+
+// pad fills the bytes up to off, the padding of a struct, with zeros.
+func (a *abiAssign) pad(off int64) {
+	if off > a.off {
+		a.pieces = append(a.pieces, op.Piece{Kind: op.ImmPiece, Size: int(off - a.off), Bytes: make([]byte, off-a.off)})
+		a.off = off
+	}
+}
