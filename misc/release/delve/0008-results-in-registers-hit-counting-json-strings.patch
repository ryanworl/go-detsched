+// regABIReturns reads the results in args that the debug information
+// left unreadable, as at the return of optimized code, from the registers
+// the ABI returns them in when s is stopped at a RET instruction, and
+// otherwise says why they cannot be read and what can.
+func regABIReturns(tgt *proc.Target, s *proc.EvalScope, args []api.Variable, cfg proc.LoadConfig) {
+	unreadable := false
+	for _, v := range args {
+		unreadable = unreadable || v.Flags&api.VariableReturnArgument != 0 && v.Unreadable != ""
+	}
+	if !unreadable {
+		return
+	}
+	var results []*proc.Variable
+	if text, err := proc.Disassemble(tgt.Memory(), nil, tgt.Breakpoints(), tgt.BinInfo(), s.PC, s.PC+16); err == nil && len(text) > 0 && text[0].IsRet() {
+		results, _ = s.RegABIResults(cfg)
+	}
+	const hint = "; replay a build without optimizations to read it (delve.md: Read locals)"
+	for i := range args {
+		v := &args[i]
+		if v.Flags&api.VariableReturnArgument == 0 || v.Unreadable == "" {
+			continue
+		}
+		why := "optimized code has no location for this result at this return (" + v.Unreadable + ")"
+		for _, r := range results {
+			if r.Name != v.Name {
+				continue
+			}
+			if r.Unreadable == nil {
+				*v = *api.ConvertVar(r)
+				why = ""
+			} else {
+				why = r.Unreadable.Error()
+			}
+			break
+		}
+		if why != "" {
+			v.Unreadable = why + hint
+		}
+	}
