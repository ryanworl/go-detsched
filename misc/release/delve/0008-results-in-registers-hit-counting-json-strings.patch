+			r["state"], r["location"] = "suspended", bp.ExprString
+		}
+		if bp.ExprString == "" {
+			addrs := []string{}
+			for _, a := range bp.Addrs {
+				addrs = append(addrs, fmt.Sprintf("%#x", a))
+			}
+			r["addrs"], r["func"], r["file"], r["line"] = addrs, bp.FunctionName, t.formatPath(bp.File), bp.Line
+		}
+		if bp.Cond != "" {
+			r["cond"] = bp.Cond
+		}
+		if bp.HitCond != "" {
+			r["hitcond"] = bp.HitCond
+			if bp.HitCondPerG {
+				r["hitcond_per_g"] = true
+			}
+			// Who counts the hits: the runtime of a detsched program, at no
+			// cost until the hit before the one wanted, or Delve, at a trap
+			// a hit, and why.
+			switch {
+			case bp.RuntimeCounted:
+				r["counted_by"] = "runtime"
+			case bp.RuntimeNotCounted != "":
+				r["counted_by"], r["not_runtime_counted"] = "delve", bp.RuntimeNotCounted
+			}
+		}
+		var actions []string // what its on commands do
+		for _, a := range formatBreakpointAttrs("", bp, false) {
+			if !strings.HasPrefix(a, "cond ") {
+				actions = append(actions, a)
+			}
+		}
+		if len(actions) > 0 {
+			r["actions"] = actions
+		}
+		list = append(list, r)
+	}
+	t.jsonEmit(map[string]any{"event": "breakpoints", "breakpoints": list})
+}
