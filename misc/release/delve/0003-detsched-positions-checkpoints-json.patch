diff --git a/pkg/terminal/detsched.go b/pkg/terminal/detsched.go
new file mode 100644
index 0000000..b3bfe69
--- /dev/null
+++ b/pkg/terminal/detsched.go
@@ -0,0 +1,184 @@
+package terminal
+
+// Support for detsched programs (GOEXPERIMENT=detsched): the run's position
+// at every stop, restarting to a checkpoint or position, and running the
+// program to its end at exit so that it prints its trace line.
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"time"
+
+	"github.com/go-delve/delve/service/api"
+)
+
+// posSuffix returns " at POSITION" for a thread stopped in a detsched
+// program, or "".
+func posSuffix(th *api.Thread) string {
+	if th == nil || th.Position == nil {
+		return ""
+	}
+	return " at " + th.Position.String()
+}
+
+// detPositionRegexp matches the positions restart takes in a detsched
+// program: a checkpoint, or a point as of GODETSTOP.
+var detPositionRegexp = regexp.MustCompile(`^(c[0-9]+|t[0-9]*\.?[0-9]+|[sk][0-9]+)$`)
+
+// isDetsched reports whether the target is a detsched program, whose
+// stops have a position, also once it exited.
+func (t *Term) isDetsched() bool {
+	if !t.detSeen {
+		state, err := t.client.GetStateNonBlocking()
+		t.detSeen = err == nil && state.CurrentThread != nil && state.CurrentThread.Position != nil
+	}
+	return t.detSeen
+}
+
+// restartDetsched runs the program again to pos.
+func restartDetsched(t *Term, pos string) error {
+	if err := restartIntl(t, false, pos, false, nil, [3]string{}); err != nil {
+		return err
+	}
+	state, err := t.client.GetState()
+	if err != nil {
+		return err
+	}
+	t.oldPid = state.Pid
+	printcontext(t, state)
+	printPos(t, state.CurrentThread, printPosShowArrow)
+	t.onStop()
+	return nil
+}
+
+// detExitTimeout bounds the run to the end that exit makes.
+var detExitTimeout = 5 * time.Minute
+
+// detRunToEnd runs a detsched program that is still running to its end,
+// with every breakpoint cleared, so that it prints its trace line, which
+// says whether the run was the one replayed. It returns false if the
+// program did not end.
+func (t *Term) detRunToEnd() bool {
+	state, err := t.client.GetState()
+	if err != nil || state.Exited || state.CurrentThread == nil || state.CurrentThread.Position == nil || t.client.AttachedToExistingProcess() {
+		return true
+	}
+	t.detSay("running the program to its end without breakpoints, so that it prints its trace line (exit -k kills it instead)")
+	bps, err := t.client.ListBreakpoints(false)
+	if err == nil {
+		for _, bp := range bps {
+			t.client.ClearBreakpoint(bp.ID)
+		}
+	}
+	timer := time.AfterFunc(detExitTimeout, func() { t.client.Halt() })
+	defer timer.Stop()
+	for state = range t.client.Continue() {
+		if state.Exited {
+			if t.jsonOn() {
+				rec := map[string]any{"event": "exit", "pid": state.Pid, "status": state.ExitStatus}
+				if state.Trace != "" {
+					rec["trace"] = state.Trace
+				}
+				t.jsonEmit(rec)
+			} else {
+				fmt.Fprintln(t.stdout, exitMessage(state))
+			}
+			return true
+		}
+		if state.Err != nil {
+			break
+		}
+	}
+	t.detSay(fmt.Sprintf("the program did not end within %v, so it printed no trace line; killing it", detExitTimeout))
+	return false
+}
+
+// detSay prints a message of the debugger's own.
+func (t *Term) detSay(msg string) {
+	if t.jsonOn() {
+		t.jsonEmit(map[string]any{"event": "output", "text": msg})
+		return
+	}
+	fmt.Fprintln(t.stdout, msg)
+}
+
+// exitMessage describes the exit in state, with the program's trace line.
+func exitMessage(state *api.DebuggerState) string {
+	msg := fmt.Sprintf("Process %d has exited with status %d", state.Pid, state.ExitStatus)
+	if state.Trace != "" {
+		msg += " (" + state.Trace + ")"
+	}
+	return msg
+}
+
+// exitError returns the error a command returns when the program exited,
+// with the program's trace line, or prints the exit record and returns
+// nil in the JSON mode.
+func (t *Term) exitError(state *api.DebuggerState) error {
+	if t.jsonOn() {
+		rec := map[string]any{"event": "exit", "pid": state.Pid, "status": state.ExitStatus}
+		if state.Trace != "" {
+			rec["trace"] = state.Trace
+		}
+		t.jsonEmit(rec)
+		return nil
+	}
+	return errors.New(exitMessage(state))
+}
+
+// detschedCommands returns the commands for going back in a detsched
+// program, which a recording has too.
+func detschedCommands(c *Commands) []command {
+	return []command{
+		{
+			aliases: []string{"rewind", "rw"},
+			group:   runCmds,
+			cmdFn:   c.rewind,
+			helpMsg: `Goes back to the previous breakpoint stop of a detsched run.
+
+	rewind
+
+In a program built with GOEXPERIMENT=detsched, the run is the same every time, so rewind runs the program again from its start to the last stop at a breakpoint (not a tracepoint) before the current position in this session, with the breakpoints disabled on the way, or to the start of the program if there is none. Each rewind goes back one more stop.
+
+See also: "help checkpoint", "help restart".`,
+		},
+		{
+			aliases: []string{"check", "checkpoint"},
+			cmdFn:   checkpoint,
+			helpMsg: `Creates a checkpoint at the current position of a detsched run.
+
+	checkpoint [note]
+
+In a program built with GOEXPERIMENT=detsched, a checkpoint records the run's position: the tick, the goroutine and instruction where it is stopped, and the hit counts of the breakpoints. "restart cN" runs the program again to it, which, as the run is the same every time, has the same state there. The note defaults to the current function and line.`,
+		},
+		{
+			aliases: []string{"checkpoints"},
+			cmdFn:   checkpoints,
+			helpMsg: "Print out info for existing checkpoints.",
+		},
+		{
+			aliases: []string{"clear-checkpoint", "clearcheck"},
+			cmdFn:   clearCheckpoint,
+			helpMsg: `Deletes checkpoint.
+
+	clear-checkpoint <id>`,
+		},
+	}
+}
+
+// jsonFilteredVariables prints the record of the args or locals command.
+func (t *Term) jsonFilteredVariables(kind string, vars []api.Variable, filter string) error {
+	reg, err := regexp.Compile(filter)
+	if err != nil {
+		return err
+	}
+	var match []api.Variable
+	for _, v := range vars {
+		if reg.MatchString(v.Name) {
+			match = append(match, v)
+		}
+	}
+	t.jsonEmit(map[string]any{"event": kind, "vars": t.jsonVars(match, 0)})
+	return nil
+}
