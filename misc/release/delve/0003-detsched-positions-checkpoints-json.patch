+package debugger
+
+// Going back in a detsched program (GOEXPERIMENT=detsched): its run is the
+// same every time, so a checkpoint is a position of the run, and restarting
+// to it runs the program again from the start to that position, with the
+// user's breakpoints disabled on the way, rr-style. The runtime stops the
+// new run at the checkpoint's tick (see proc.DetSetStop), and an internal
+// breakpoint then stops at the checkpoint's instruction in its goroutine at
+// that tick: in user code, where every function entry and loop back edge
+// counts a tick, an instruction runs at most once per tick.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/go-delve/delve/pkg/proc"
+)
+
+// detMark is a point of a detsched run that the debugger can run the
+// program again to: a checkpoint, or a stop that rewind goes back to.
+type detMark struct {
+	id   int
+	note string
+	pos  proc.DetPos
+	pc   uint64
+	hits map[int]detHits // the user breakpoints' hit counts, by ID
+}
+
+type detHits struct {
+	total uint64
+	perG  map[int64]uint64
+}
+
+type detState struct {
+	marks   []*detMark
+	nextID  int
+	history []*detMark // the breakpoint stops of the run, for rewind
+}
+
+// detsched reports whether the target is a live detsched program, which
+// checkpoints, restarts to a position, and rewinds by running it again.
+func (d *Debugger) detsched() bool {
+	if recorded, _ := d.target.Recorded(); recorded || len(d.target.Targets()) != 1 {
+		return false
+	}
+	return d.target.Selected.IsDetsched()
+}
+
+// detMarkHere returns the point where the run is stopped.
+func (d *Debugger) detMarkHere(note string) (*detMark, error) {
+	tgt := d.target.Selected
+	if _, err := tgt.Valid(); err != nil {
+		return nil, err
+	}
+	th := tgt.CurrentThread()
+	regs, err := th.Registers()
+	if err != nil {
+		return nil, err
+	}
+	g, _ := proc.GetG(th)
+	pos, err := proc.DetPosition(tgt, g)
+	if err != nil {
+		return nil, err
+	}
+	m := &detMark{note: note, pos: *pos, pc: regs.PC(), hits: map[int]detHits{}}
+	for id, lbp := range d.target.LogicalBreakpoints {
+		h := detHits{total: lbp.TotalHitCount, perG: map[int64]uint64{}}
+		for g, n := range lbp.HitCount {
+			h.perG[g] = n
+		}
+		m.hits[id] = h
+	}
+	return m, nil
+}
+
+// detWhen describes m's position for the list of checkpoints.
+func (m *detMark) when() string {
+	return fmt.Sprintf("%s goroutine %d", m.pos.String(), m.pos.Goroutine)
+}
+
+func (d *Debugger) detCheckpoint(note string) (int, error) {
+	m, err := d.detMarkHere(note)
+	if err != nil {
+		return 0, err
+	}
+	d.det.nextID++
+	m.id = d.det.nextID
+	d.det.marks = append(d.det.marks, m)
+	return m.id, nil
+}
+
+func (d *Debugger) detCheckpoints() []proc.Checkpoint {
+	r := make([]proc.Checkpoint, 0, len(d.det.marks))
+	for _, m := range d.det.marks {
+		r = append(r, proc.Checkpoint{ID: m.id, When: m.when(), Where: m.note})
+	}
+	return r
+}
+
+func (d *Debugger) detClearCheckpoint(id int) error {
+	for i, m := range d.det.marks {
+		if m.id == id {
+			d.det.marks = append(d.det.marks[:i], d.det.marks[i+1:]...)
+			return nil
+		}
+	}
+	return fmt.Errorf("no checkpoint c%d", id)
+}
+
+// detRecordStop adds the stop the run is at to the history rewind goes
+// back through, if it is at a user breakpoint.
+func (d *Debugger) detRecordStop() {
+	if !d.detsched() {
+		return
+	}
+	tgt := d.target.Selected
+	bp := tgt.CurrentThread().Breakpoint()
+	if bp.Breakpoint == nil || !bp.Active || bp.Breakpoint.Logical == nil {
+		return
+	}
+	lbp := bp.Breakpoint.Logical
+	if lbp.LogicalID <= 0 || lbp.Tracepoint || lbp.TraceReturn {
+		return
+	}
+	m, err := d.detMarkHere(lbp.FunctionName)
+	if err != nil {
+		return
+	}
+	d.det.history = append(d.det.history, m)
+}
+
+// detRestart runs the program again to pos: a checkpoint cN, or a point
+// as of GODETSTOP, tD, sN or kN.
+func (d *Debugger) detRestart(pos string) error {
+	var mark *detMark
+	var kind byte
+	var n uint64
+	if len(pos) > 1 && pos[0] == 'c' {
+		id, err := strconv.Atoi(pos[1:])
+		if err != nil {
+			return fmt.Errorf("%q is not a checkpoint", pos)
+		}
+		for _, m := range d.det.marks {
+			if m.id == id {
+				mark = m
+			}
+		}
+		if mark == nil {
+			return fmt.Errorf("no checkpoint c%d", id)
+		}
+	} else {
+		var err error
+		kind, n, err = proc.ParseDetPoint(pos)
+		if err != nil {
+			return err
+		}
+	}
+	if err := d.detRelaunch(); err != nil {
+		return err
+	}
+	if mark != nil {
+		return d.detRunToMark(mark)
+	}
+	return d.detRunToPoint(kind, n, pos)
+}
+
+// detRelaunch kills the program and starts it again, stopped before its
+// first instruction, with the same breakpoints.
+func (d *Debugger) detRelaunch() error {
+	if !d.canRestart() {
+		return ErrCanNotRestart
+	}
+	if err := d.detach(true); err != nil {
+		return err
+	}
+	grp, err := d.Launch(d.processArgs, d.config.WorkingDir)
+	if err != nil {
+		return fmt.Errorf("could not launch process: %s", err)
+	}
+	proc.Restart(grp, d.target, func(oldBp *proc.LogicalBreakpoint, err error) {
+		d.log.Warnf("could not restore breakpoint %d: %v", oldBp.LogicalID, err)
+	})
+	d.target = grp
+	return nil
+}
+
+// detWithoutBreakpoints runs f with the user's breakpoints disabled, and
+// then gives them the hit counts in hits, if not nil, and enables them
+// again.
+func (d *Debugger) detWithoutBreakpoints(hits map[int]detHits, f func() error) error {
+	var disabled []*proc.LogicalBreakpoint
+	for id, lbp := range d.target.LogicalBreakpoints {
+		if id > 0 && lbp.Enabled() {
+			if err := d.target.SetBreakpointEnabled(lbp, false); err != nil {
+				return err
+			}
+			disabled = append(disabled, lbp)
+		}
+	}
+	err := f()
+	if _, verr := d.target.Valid(); verr != nil {
+		return errors.Join(err, verr)
+	}
+	for id, lbp := range d.target.LogicalBreakpoints {
+		if h, ok := hits[id]; ok {
+			lbp.TotalHitCount = h.total
+			lbp.HitCount = map[int64]uint64{}
+			for g, n := range h.perG {
+				lbp.HitCount[g] = n
+			}
+		}
+	}
+	for _, lbp := range disabled {
+		if err1 := d.target.SetBreakpointEnabled(lbp, true); err1 != nil && err == nil {
+			err = err1
+		}
+	}
+	return err
+}
+
+// detContinueTo continues to the internal breakpoint at addr, which stops
+// when cb says so, and reports an error if the run stopped elsewhere.
+func (d *Debugger) detContinueTo(addr uint64, cb func(proc.Thread, *proc.Target) (bool, error), what string) error {
+	tgt := d.target.Selected
+	if _, err := tgt.DetSetBreakpoint(addr, cb); err != nil {
+		return err
+	}
+	err := d.target.Continue()
+	if _, verr := tgt.Valid(); verr == nil {
+		tgt.DetClearBreakpoint(addr)
+	}
+	var exited proc.ErrProcessExited
+	if errors.As(err, &exited) {
+		return fmt.Errorf("the program exited with status %d before reaching %s", exited.Status, what)
+	}
+	if err != nil {
+		return err
+	}
+	th := d.target.Selected.CurrentThread()
+	bp := th.Breakpoint()
+	if bp.Breakpoint == nil || bp.Breakpoint.Addr != addr {
+		loc, _ := proc.ThreadLocation(th)
+		where := "?"
+		if loc != nil && loc.Fn != nil {
+			where = fmt.Sprintf("%s %s:%d", loc.Fn.Name, loc.File, loc.Line)
+		}
+		if bp.Breakpoint != nil && bp.Breakpoint.Logical != nil && bp.Breakpoint.Logical.Name != "" {
+			where = bp.Breakpoint.Logical.Name + " in " + where
+		}
+		return fmt.Errorf("the program stopped at %s before reaching %s", where, what)
+	}
+	return nil
+}
+
+// detRunToPoint continues the newly started program to a point as of
+// GODETSTOP, and then out of the runtime into the code of the goroutine
+// that runs there.
+func (d *Debugger) detRunToPoint(kind byte, n uint64, what string) error {
+	return d.detWithoutBreakpoints(nil, func() error {
+		tgt := d.target.Selected
+		if err := tgt.DetSetStop(kind, n); err != nil {
+			return err
+		}
+		always := func(proc.Thread, *proc.Target) (bool, error) { return true, nil }
+		if err := d.detContinueTo(tgt.DetStopPC(), always, what); err != nil {
+			return err
+		}
+		tgt = d.target.Selected
+		th := tgt.CurrentThread()
+		g, err := proc.GetG(th)
+		if err != nil || g == nil {
+			return nil
+		}
+		frames, err := proc.ThreadStacktrace(tgt, th, 6)
+		if err != nil {
+			return nil
+		}
+		for _, f := range frames {
+			if f.Current.Fn != nil && f.Current.Fn.Name == "runtime.detPreempt" && f.Ret != 0 {
+				goid := g.ID
+				ingoroutine := func(th proc.Thread, _ *proc.Target) (bool, error) {
+					g, _ := proc.GetG(th)
+					return g != nil && g.ID == goid, nil
+				}
+				return d.detContinueTo(f.Ret, ingoroutine, what)
+			}
+		}
+		return nil
+	})
+}
+
+// detRunToMark continues the newly started program to m.
+//
+// The runtime stops the run at m's tick only if its goroutine's own code
+// runs there: package sim runs some of its code, such as a node's crash,
+// on the system stack, where the run cannot stop until it leaves it. When
+// the stop comes after m, the program runs again to m's switch, or an
+// earlier one, and as a last resort from its start.
+func (d *Debugger) detRunToMark(m *detMark) error {
+	what := fmt.Sprintf("c%d (%s)", m.id, m.when())
+	if m.id == 0 {
+		what = m.when()
+	}
+	type point struct {
+		kind byte
+		n    uint64
+	}
+	var tries []point
+	if m.pos.Tick > 0 {
+		tries = append(tries, point{'k', uint64(m.pos.Tick)})
+		for s := m.pos.Switches; s > 0 && s+3 > m.pos.Switches; s-- {
+			tries = append(tries, point{'s', s})
+		}
+	}
+	tries = append(tries, point{})
+	return d.detWithoutBreakpoints(m.hits, func() error {
+		for i, p := range tries {
+			if i > 0 {
+				if err := d.detRelaunch(); err != nil {
+					return err
+				}
+			}
+			if p.kind == 0 {
+				break
+			}
+			tgt := d.target.Selected
+			if err := tgt.DetSetStop(p.kind, p.n); err != nil {
+				return err
+			}
+			always := func(proc.Thread, *proc.Target) (bool, error) { return true, nil }
+			if err := d.detContinueTo(tgt.DetStopPC(), always, what); err != nil {
+				return err
+			}
+			here, err := d.detMarkHere("")
+			if err != nil {
+				return err
+			}
+			if here.pos.Tick <= m.pos.Tick {
+				break
+			}
+		}
+		if d.detAt(m) {
+			return nil
+		}
+		var passed bool
+		cb := func(th proc.Thread, p *proc.Target) (bool, error) {
+			g, _ := proc.GetG(th)
+			if m.pos.Goroutine != 0 && (g == nil || g.ID != m.pos.Goroutine) {
+				return false, nil
+			}
+			pos, err := proc.DetPosition(p, g)
+			if err != nil {
+				return false, err
+			}
+			passed = pos.Tick > m.pos.Tick
+			return pos.Tick >= m.pos.Tick, nil
+		}
+		if err := d.detContinueTo(m.pc, cb, what); err != nil {
+			return err
+		}
+		if passed {
+			return fmt.Errorf("the run passed %s without stopping there; it stopped at the next hit of the same instruction", what)
+		}
+		return nil
+	})
+}
+
+// detAt reports whether the program is stopped at m.
+func (d *Debugger) detAt(m *detMark) bool {
+	h, err := d.detMarkHere("")
+	return err == nil && h.pc == m.pc && h.pos.Tick == m.pos.Tick && h.pos.Goroutine == m.pos.Goroutine
+}
+
+// detRewind runs the program again to the last breakpoint stop before
+// the current one, or to its start if there is none.
+func (d *Debugger) detRewind() error {
+	// After the program exited, every stop is before the current
+	// position.
+	here, err := d.detMarkHere("")
+	if err != nil && !errors.As(err, new(proc.ErrProcessExited)) {
+		return err
+	}
+	// The history is in the order of the run, but may go on past the
+	// current stop after a restart to a checkpoint.
+	h := d.det.history
+	for here != nil && len(h) > 0 {
+		last := h[len(h)-1]
+		if last.pos.Tick < here.pos.Tick || last.pos.Tick == here.pos.Tick && (last.pc != here.pc || last.pos.Goroutine != here.pos.Goroutine) {
+			break
+		}
+		h = h[:len(h)-1]
+	}
+	d.det.history = h
+	if len(h) == 0 {
+		return d.detRelaunch()
+	}
+	m := h[len(h)-1]
+	if err := d.detRelaunch(); err != nil {
+		return err
+	}
+	return d.detRunToMark(m)
+}
+
+// detTraceLine returns the first "detsched: trace=" line in the file the
+// program's standard error went to, if it went to a file.
+func (d *Debugger) detTraceLine() string {
+	if d.config.Stderr.Path == "" || !d.detschedBinary() {
+		return ""
+	}
+	data, err := os.ReadFile(d.config.Stderr.Path)
+	if err != nil {
+		return ""
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		if strings.HasPrefix(line, "detsched: trace=") {
+			return line
+		}
+	}
+	return ""
+}
+
+// detschedBinary reports whether the target was built with
+// GOEXPERIMENT=detsched, also once it exited.
+func (d *Debugger) detschedBinary() bool {
+	return len(d.target.Targets()) > 0 && d.target.Targets()[0].IsDetsched()
+}
