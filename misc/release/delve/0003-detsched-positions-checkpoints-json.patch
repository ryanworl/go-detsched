diff --git a/pkg/proc/detsched.go b/pkg/proc/detsched.go
new file mode 100644
index 0000000..15bd82b
--- /dev/null
+++ b/pkg/proc/detsched.go
@@ -0,0 +1,435 @@
+package proc
+
+// Support for programs built with GOEXPERIMENT=detsched, the deterministic
+// scheduler of the detsched Go toolchain. Such a program runs one
+// goroutine at a time, and a run is fully determined by its binary, its
+// environment and its arguments, so a debugger can name a point of the run
+// by its position and run the program again to that point.
+//
+// The position of a run is read from the runtime's variables:
+//
+//   - the tick, runtime.detTickEnd-int64(runtime.detTicks): the compiler
+//     counts one at every function entry and loop back edge in user code;
+//   - the switch, allp[0].det[0].switches: goroutine switches so far;
+//   - the virtual time of the goroutine's synctest bubble, g.bubble.now,
+//     counted from the bubble's start, 2000-01-01 UTC;
+//   - the simulated node of the goroutine (package sim of the detsched
+//     SDK), g.det[0].node, named by runtime.detsimNames.
+//
+// The runtime's variable runtime.detDebug lets the debugger stop the run at
+// a position: the runtime calls runtime.detDebugStop there.
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"go/constant"
+	"strconv"
+	"strings"
+
+	"github.com/go-delve/delve/pkg/dwarf/godwarf"
+)
+
+// detBubbleStart is the time at which every synctest bubble starts,
+// midnight UTC 2000-01-01, in nanoseconds since the Unix epoch.
+const detBubbleStart = 946684800000000000
+
+// DetPos is the position of a detsched run.
+type DetPos struct {
+	Tick      int64  // ticks counted since the program started
+	Switches  uint64 // goroutine switches so far
+	Time      int64  // nanoseconds of the goroutine's bubble since it started, -1 outside a bubble
+	Node      string // the goroutine's simulated node, "" for none
+	Goroutine int64
+}
+
+// TimeString returns p's virtual time in seconds, as GODETSTOP and the
+// fault timeline of package sim write it, or "-" outside a bubble.
+func (p *DetPos) TimeString() string {
+	if p.Time < 0 {
+		return "-"
+	}
+	return fmt.Sprintf("%d.%09d", p.Time/1e9, p.Time%1e9)
+}
+
+// String returns p as the runtime's stop lines write a position, followed
+// by the node, if any: "t9.408758544 s1822 k90267 node n1 (start 2)".
+func (p *DetPos) String() string {
+	s := fmt.Sprintf("t%s s%d k%d", p.TimeString(), p.Switches, p.Tick)
+	if p.Node != "" {
+		s += " node " + p.Node
+	}
+	return s
+}
+
+// detInfo holds the addresses and offsets of what the debugger reads and
+// writes in a detsched program.
+type detInfo struct {
+	tickEnd, ticks, allp, names, debug, simState uint64
+
+	gBubble, gDet, detGSize, detGNode, bubbleNow, pDet, detPSwitches int64
+
+	stopKind, stopN, nwatch, watch, watchSize, watchPC, watchCount, watchAt int64
+	nslots                                                                  int
+
+	stopFn, watchFn, preemptFn uint64
+}
+
+var errNotDetsched = errors.New("not a detsched program (built without GOEXPERIMENT=detsched, or by a detsched toolchain older than this dlv)")
+
+// detInfo returns t's detInfo, or nil if t is not a detsched program.
+func (t *Target) detInfo() *detInfo {
+	bi := t.BinInfo()
+	if bi.detDone {
+		return bi.det
+	}
+	bi.detDone = true
+	di, err := loadDetInfo(t)
+	if err != nil {
+		bi.logger.Debugf("detsched: %v", err)
+		return nil
+	}
+	bi.det = di
+	return di
+}
+
+// IsDetsched reports whether t was built with GOEXPERIMENT=detsched by a
+// toolchain whose runtime this debugger can drive.
+func (t *Target) IsDetsched() bool {
+	return t.detInfo() != nil
+}
+
+func loadDetInfo(t *Target) (*detInfo, error) {
+	bi := t.BinInfo()
+	if len(bi.Images) == 0 {
+		return nil, errNotDetsched
+	}
+	fns := bi.LookupFunc()
+	fnEntry := func(name string) uint64 {
+		if f := fns[name]; len(f) > 0 {
+			return f[0].Entry
+		}
+		return 0
+	}
+	di := &detInfo{
+		stopFn:    fnEntry("runtime.detDebugStop"),
+		watchFn:   fnEntry("runtime.detDebugWatch"),
+		preemptFn: fnEntry("runtime.detPreempt"),
+	}
+	if di.stopFn == 0 || di.watchFn == 0 || di.preemptFn == 0 {
+		return nil, errNotDetsched
+	}
+	scope := globalScope(t, bi, bi.Images[0], t.Memory())
+	global := func(name string) (*Variable, error) {
+		v, err := scope.findGlobal("runtime", name)
+		if err != nil {
+			return nil, err
+		}
+		return v, nil
+	}
+	var debugType, simType godwarf.Type
+	for _, x := range []struct {
+		name string
+		addr *uint64
+	}{
+		{"detTickEnd", &di.tickEnd},
+		{"detTicks", &di.ticks},
+		{"allp", &di.allp},
+		{"detsimNames", &di.names},
+		{"detDebug", &di.debug},
+		{"detsim", &di.simState},
+	} {
+		v, err := global(x.name)
+		if err != nil {
+			return nil, err
+		}
+		*x.addr = v.Addr
+		switch x.name {
+		case "detDebug":
+			debugType = v.RealType
+		case "detsim":
+			simType = v.RealType
+		}
+	}
+	field := func(typ godwarf.Type, name string) (*godwarf.StructField, error) {
+		st, ok := godwarf.ResolveTypedef(typ).(*godwarf.StructType)
+		if !ok {
+			return nil, fmt.Errorf("%s is not a struct", typ)
+		}
+		for _, f := range st.Field {
+			if f.Name == name {
+				return f, nil
+			}
+		}
+		return nil, fmt.Errorf("%s has no field %s", typ, name)
+	}
+	typ := func(name string) (godwarf.Type, error) { return bi.findType(name) }
+	var err error
+	off := func(t godwarf.Type, name string) int64 {
+		if err != nil {
+			return 0
+		}
+		var f *godwarf.StructField
+		f, err = field(t, name)
+		if err != nil {
+			return 0
+		}
+		return f.ByteOffset
+	}
+	gT, err1 := typ("runtime.g")
+	pT, err2 := typ("runtime.p")
+	bT, err3 := typ("runtime.synctestBubble")
+	dgT, err4 := typ("runtime.detGState")
+	dpT, err5 := typ("runtime.detPState")
+	wT, err6 := typ("runtime.detWatch")
+	spT, err7 := typ("runtime.detStopPoint")
+	if err := errors.Join(err1, err2, err3, err4, err5, err6, err7); err != nil {
+		return nil, err
+	}
+	di.gBubble = off(gT, "bubble")
+	di.gDet = off(gT, "det")
+	di.detGSize = dgT.Size()
+	di.detGNode = off(dgT, "node")
+	di.bubbleNow = off(bT, "now")
+	di.pDet = off(pT, "det")
+	di.detPSwitches = off(dpT, "switches")
+	stop := off(debugType, "stop")
+	di.stopKind = stop + off(spT, "kind")
+	di.stopN = stop + off(spT, "n")
+	di.nwatch = off(debugType, "nwatch")
+	di.watch = off(debugType, "watch")
+	di.watchSize = wT.Size()
+	di.watchPC = off(wT, "pc")
+	di.watchCount = off(wT, "count")
+	di.watchAt = off(wT, "at")
+	di.simState += uint64(off(simType, "state"))
+	if err != nil {
+		return nil, err
+	}
+	if f, err := field(debugType, "watch"); err == nil {
+		if at, ok := godwarf.ResolveTypedef(f.Type).(*godwarf.ArrayType); ok {
+			di.nslots = int(at.Count)
+		}
+	}
+	return di, nil
+}
+
+// DetPosition returns the position of t's run, with g's time and node, or
+// those of the selected goroutine if g is nil.
+func DetPosition(t *Target, g *G) (*DetPos, error) {
+	di := t.detInfo()
+	if di == nil {
+		return nil, errNotDetsched
+	}
+	if g == nil {
+		g = t.SelectedGoroutine()
+	}
+	return di.position(t.BinInfo(), t.Memory(), g)
+}
+
+func (di *detInfo) position(bi *BinaryInfo, mem MemoryReadWriter, g *G) (*DetPos, error) {
+	if cm, ok := mem.(*compositeMemory); ok {
+		mem = cm.realmem
+	}
+	ptr := int64(bi.Arch.PtrSize())
+	end, err := readIntRaw(mem, di.tickEnd, 8)
+	if err != nil {
+		return nil, err
+	}
+	ticks, err := readIntRaw(mem, di.ticks, 4)
+	if err != nil {
+		return nil, err
+	}
+	pos := &DetPos{Tick: end - ticks, Time: -1}
+	if allp, err := readUintRaw(mem, di.allp, ptr); err == nil && allp != 0 {
+		if p, err := readUintRaw(mem, allp, ptr); err == nil && p != 0 {
+			pos.Switches, _ = readUintRaw(mem, p+uint64(di.pDet+di.detPSwitches), 8)
+		}
+	}
+	if g == nil || g.variable == nil {
+		return pos, nil
+	}
+	pos.Goroutine = g.ID
+	gaddr := g.variable.Addr
+	if b, err := readUintRaw(mem, gaddr+uint64(di.gBubble), ptr); err == nil && b != 0 {
+		if now, err := readIntRaw(mem, b+uint64(di.bubbleNow), 8); err == nil {
+			pos.Time = now - detBubbleStart
+		}
+	}
+	pos.Node, _ = di.node(bi, mem, gaddr)
+	return pos, nil
+}
+
+// node returns the name of the node of the goroutine at gaddr, as package
+// sim named it, else its handle, and its state, "crashed" or "paused" if
+// it is not live.
+func (di *detInfo) node(bi *BinaryInfo, mem MemoryReadWriter, gaddr uint64) (name, state string) {
+	ptr := int64(bi.Arch.PtrSize())
+	node, err := readIntRaw(mem, gaddr+uint64(di.gDet+di.detGNode), 4)
+	if err != nil || node == 0 {
+		return "", ""
+	}
+	if data, err := readUintRaw(mem, di.simState, ptr); err == nil {
+		if n, err := readIntRaw(mem, di.simState+uint64(ptr), ptr); err == nil && node < n {
+			if s, err := readUintRaw(mem, data+uint64(node), 1); err == nil {
+				switch s { // detsimLive, detsimPaused, detsimDead
+				case 1:
+					state = "paused"
+				case 2:
+					state = "crashed"
+				}
+			}
+		}
+	}
+	name = strconv.FormatInt(node, 10)
+	data, err1 := readUintRaw(mem, di.names, ptr)
+	n, err2 := readIntRaw(mem, di.names+uint64(ptr), ptr)
+	if err1 != nil || err2 != nil || node >= n {
+		return name, state
+	}
+	s, err1 := readUintRaw(mem, data+uint64(node*2*ptr), ptr)
+	l, err2 := readIntRaw(mem, data+uint64(node*2*ptr+ptr), ptr)
+	if err1 != nil || err2 != nil || l <= 0 || l > 1024 {
+		return name, state
+	}
+	buf := make([]byte, l)
+	if _, err := mem.ReadMemory(buf, s); err != nil {
+		return name, state
+	}
+	return string(buf), state
+}
+
+// DetNode returns the name of g's simulated node, "" for none, and its
+// state, "crashed" or "paused" if it is not live.
+func DetNode(t *Target, g *G) (name, state string) {
+	di := t.detInfo()
+	if di == nil || g == nil || g.variable == nil {
+		return "", ""
+	}
+	return di.node(t.BinInfo(), t.Memory(), g.variable.Addr)
+}
+
+// evalDetsched evaluates detsched.NAME in scope.
+func evalDetsched(scope *EvalScope, name string) (*Variable, error) {
+	if scope.target == nil {
+		return nil, errNotDetsched
+	}
+	di := scope.target.detInfo()
+	if di == nil {
+		return nil, errNotDetsched
+	}
+	pos, err := di.position(scope.BinInfo, scope.Mem, scope.g)
+	if err != nil {
+		return nil, err
+	}
+	var v constant.Value
+	switch name {
+	case "time":
+		if pos.Time < 0 {
+			v = constant.MakeFloat64(-1)
+		} else {
+			v = constant.MakeFloat64(float64(pos.Time) / 1e9)
+		}
+	case "tick":
+		v = constant.MakeInt64(pos.Tick)
+	case "switches":
+		v = constant.MakeUint64(pos.Switches)
+	case "node":
+		v = constant.MakeString(pos.Node)
+	default:
+		return nil, fmt.Errorf("unknown detsched.%s (detsched.time, detsched.tick, detsched.switches and detsched.node are known)", name)
+	}
+	return newConstant(v, scope.BinInfo, scope.Mem), nil
+}
+
+// ParseDetPoint parses a position as GODETSTOP writes a point: tD for D
+// seconds of virtual time, sN for switch N, kN for tick N.
+func ParseDetPoint(s string) (kind byte, n uint64, err error) {
+	bad := fmt.Errorf("%q is not a position: tD (seconds of virtual time), sN (switch) or kN (tick)", s)
+	if len(s) < 2 {
+		return 0, 0, bad
+	}
+	kind = s[0]
+	switch kind {
+	case 's', 'k':
+		n, err = strconv.ParseUint(s[1:], 10, 62)
+	case 't':
+		whole, frac, _ := strings.Cut(s[1:], ".")
+		if len(frac) > 9 {
+			return 0, 0, bad
+		}
+		var w, f uint64
+		if whole != "" {
+			w, err = strconv.ParseUint(whole, 10, 32)
+		}
+		if err == nil && frac != "" {
+			f, err = strconv.ParseUint((frac + "000000000")[:9], 10, 64)
+		}
+		n = w*1e9 + f
+	default:
+		return 0, 0, bad
+	}
+	if err != nil {
+		return 0, 0, bad
+	}
+	return kind, n, nil
+}
+
+// DetSetStop makes the run stop at a position, a point as of GODETSTOP of
+// the given kind ('t', 's' or 'k'), by calling runtime.detDebugStop there.
+// It must be called before the program starts. DetStopPC returns the
+// address to break at.
+func (t *Target) DetSetStop(kind byte, n uint64) error {
+	di := t.detInfo()
+	if di == nil {
+		return errNotDetsched
+	}
+	mem := t.Memory()
+	if _, err := mem.WriteMemory(di.debug+uint64(di.stopN), le64(n)); err != nil {
+		return err
+	}
+	_, err := mem.WriteMemory(di.debug+uint64(di.stopKind), []byte{kind})
+	return err
+}
+
+// DetStopPC returns the address of runtime.detDebugStop, where a run
+// stops at the position DetSetStop gave it.
+func (t *Target) DetStopPC() uint64 {
+	if di := t.detInfo(); di != nil {
+		return di.stopFn
+	}
+	return 0
+}
+
+// DetSetBreakpoint sets an internal breakpoint at addr, which stops when
+// cb returns true.
+func (t *Target) DetSetBreakpoint(addr uint64, cb func(Thread, *Target) (bool, error)) (*Breakpoint, error) {
+	bp, err := t.SetBreakpoint(0, addr, DetschedBreakpoint, nil)
+	if err != nil {
+		return nil, err
+	}
+	bp.Breaklets[len(bp.Breaklets)-1].callback = cb
+	return bp, nil
+}
+
+// DetClearBreakpoint clears the internal breakpoint DetSetBreakpoint set
+// at addr, and leaves any other breakpoint there.
+func (t *Target) DetClearBreakpoint(addr uint64) error {
+	bp := t.Breakpoints().M[addr]
+	if bp == nil {
+		return nil
+	}
+	for i, b := range bp.Breaklets {
+		if b.Kind == DetschedBreakpoint {
+			bp.Breaklets[i] = nil
+		}
+	}
+	_, err := t.finishClearBreakpoint(bp)
+	return err
+}
+
+func le64(n uint64) []byte {
+	b := make([]byte, 8)
+	binary.LittleEndian.PutUint64(b, n)
+	return b
+}
