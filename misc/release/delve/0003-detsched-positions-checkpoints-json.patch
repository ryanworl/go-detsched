new file mode 100644
index 0000000..4df6b3f
--- /dev/null
+++ b/pkg/terminal/json.go
@@ -0,0 +1,251 @@
+package terminal
+
+// The JSON output mode (dlv --json, or "config output json"): every line
+// Delve prints is one JSON object, for scripts and agents that read
+// Delve's output without filtering text. Each command of a script or of
+// the prompt prints at least one record:
+//
+//	{"cmd":"print x","event":"value","expr":"x","type":"int","value":"3"}
+//	{"cmd":"continue","event":"trace","bp":"pf","goroutine":16,...}
+//	{"cmd":"continue","event":"exit","status":0,"trace":"detsched: trace=..."}
+//	{"cmd":"break pf sim.(*disk).powerFail","event":"output","text":"Breakpoint pf set at ..."}
+//	{"cmd":"print y","event":"error","error":"could not find symbol value for y"}
+//
+// Commands without a record of their own print their text in an "output"
+// record, and a command that printed nothing prints {"event":"ok"}. A
+// command read from a file has "src":"FILE:LINE". The program's own output
+// is not Delve's: send it elsewhere with -r stdout:FILE -r stderr:FILE, or
+// skip the lines that do not start with "{".
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/go-delve/delve/service/api"
+)
+
+// jsonOut is the state of the JSON output mode.
+type jsonOut struct {
+	w       io.Writer // where records go
+	cmd     string    // the command running
+	src     string    // its file and line, if it came from a file
+	emitted bool      // the command printed a record
+	depth   int
+}
+
+// jsonOn reports whether the terminal prints JSON records.
+func (t *Term) jsonOn() bool { return t != nil && t.json != nil }
+
+// jsonEmit prints rec, with the command that printed it.
+func (t *Term) jsonEmit(rec map[string]any) {
+	j := t.json
+	if j.cmd != "" {
+		rec["cmd"] = j.cmd
+	}
+	if j.src != "" {
+		rec["src"] = j.src
+	}
+	b, err := json.Marshal(rec)
+	if err != nil {
+		b, _ = json.Marshal(map[string]any{"event": "error", "error": err.Error()})
+	}
+	b = append(b, '\n')
+	j.w.Write(b)
+	j.emitted = true
+}
+
+var exitedRegexp = regexp.MustCompile(`^Process (\d+) has exited with status (-?\d+)`)
+
+// jsonCall runs the command cmdstr, from src if not "", and prints its
+// records: what it printed as text, or its error, or ok.
+func (t *Term) jsonCall(cmdstr, src string, call func() error) error {
+	j := t.json
+	saved := *j
+	j.cmd, j.src, j.emitted = strings.TrimSpace(cmdstr), src, false
+	j.depth++
+	var buf bytes.Buffer
+	pw := t.stdout.pw
+	t.stdout.pw = &pagingWriter{w: &buf}
+	err := call()
+	t.stdout.pw = pw
+	j.depth--
+	if text := strings.TrimRight(buf.String(), "\n"); text != "" {
+		t.jsonEmit(map[string]any{"event": "output", "text": text})
+	}
+	emitted := j.emitted
+	if err != nil {
+		if _, ok := err.(ExitRequestError); ok {
+			// The records of the exit, such as the trace line, are the
+			// command's.
+			return err
+		}
+		if m := exitedRegexp.FindStringSubmatch(err.Error()); m != nil {
+			pid, _ := strconv.Atoi(m[1])
+			status, _ := strconv.Atoi(m[2])
+			t.jsonEmit(map[string]any{"event": "exit", "pid": pid, "status": status})
+		} else {
+			t.jsonEmit(map[string]any{"event": "error", "error": err.Error()})
+		}
+		emitted = true
+	}
+	if !emitted {
+		t.jsonEmit(map[string]any{"event": "ok"})
+	}
+	emitted = emitted || saved.emitted
+	*j = saved
+	j.emitted = emitted
+	if j.depth == 0 && t.conf.Output != "json" {
+		// config output text, which takes effect after the command.
+		t.json = nil
+	}
+	return nil
+}
+
+func jsonPos(p *api.Position) map[string]any {
+	if p == nil {
+		return nil
+	}
+	r := map[string]any{"t": p.Time, "s": p.Switch, "k": p.Tick}
+	if p.Node != "" {
+		r["node"] = p.Node
+	}
+	return r
+}
+
+func (t *Term) jsonVar(v *api.Variable, name string) map[string]any {
+	r := map[string]any{"type": v.Type, "value": v.StringWithOptions("", "", t.rawStringFlag())}
+	if name != "" {
+		r["name"] = name
+	}
+	if v.Unreadable != "" {
+		r["unreadable"] = v.Unreadable
+	}
+	return r
+}
+
+func (t *Term) jsonVars(vs []api.Variable, flags api.VariableFlags) []map[string]any {
+	r := []map[string]any{}
+	for i := range vs {
+		if flags != 0 && vs[i].Flags&flags == 0 {
+			continue
+		}
+		r = append(r, t.jsonVar(&vs[i], vs[i].Name))
+	}
+	return r
+}
+
+func (t *Term) jsonFrames(stack []api.Stackframe) []map[string]any {
+	r := []map[string]any{}
+	for i := range stack {
+		f := &stack[i]
+		fr := map[string]any{"n": i, "func": f.Function.Name(), "file": t.formatPath(f.File), "line": f.Line, "pc": fmt.Sprintf("%#x", f.PC)}
+		if f.Err != "" {
+			fr["error"] = f.Err
+		}
+		r = append(r, fr)
+	}
+	return r
+}
+
+func (t *Term) jsonGoroutine(g *api.Goroutine) map[string]any {
+	if g.Unreadable != "" {
+		return map[string]any{"id": g.ID, "unreadable": g.Unreadable}
+	}
+	loc := func(l api.Location) map[string]any {
+		return map[string]any{"func": l.Function.Name(), "file": t.formatPath(l.File), "line": l.Line}
+	}
+	r := map[string]any{"id": g.ID, "user": loc(g.UserCurrentLoc), "current": loc(g.CurrentLoc), "go": loc(g.GoStatementLoc), "start": loc(g.StartLoc)}
+	if g.Node != "" {
+		r["node"] = g.Node
+	}
+	if g.NodeState != "" {
+		r["node_state"] = g.NodeState
+	}
+	if g.ThreadID != 0 {
+		r["thread"] = g.ThreadID
+	}
+	if (g.Status == api.GoroutineWaiting || g.Status == api.GoroutineSyscall) && g.WaitReason != 0 {
+		r["wait"] = api.WaitReasonString(t.goVersion(), g.WaitReason)
+	}
+	if len(g.Labels) > 0 {
+		r["labels"] = g.Labels
+	}
+	return r
+}
+
+// jsonThread prints the record of a thread stopped at a breakpoint, a
+// tracepoint, or elsewhere.
+func (t *Term) jsonThread(th *api.Thread) {
+	rec := map[string]any{
+		"event":     "stop",
+		"goroutine": th.GoroutineID,
+		"func":      th.Function.Name(),
+		"file":      t.formatPath(th.File),
+		"line":      th.Line,
+		"pc":        fmt.Sprintf("%#x", th.PC),
+	}
+	if th.Position != nil {
+		rec["pos"] = jsonPos(th.Position)
+	}
+	if bp := th.Breakpoint; bp != nil {
+		switch {
+		case bp.TraceReturn:
+			rec["event"] = "return"
+		case bp.Tracepoint:
+			rec["event"] = "trace"
+		case bp.WatchExpr != "":
+			rec["event"] = "watch"
+			rec["expr"] = bp.WatchExpr
+		default:
+			rec["event"] = "break"
+		}
+		if bp.Name != "" {
+			rec["bp"] = bp.Name
+		} else {
+			rec["bp"] = strconv.Itoa(bp.ID)
+		}
+		rec["hits"] = bp.TotalHitCount
+		if bpi := th.BreakpointInfo; bpi != nil {
+			if bp.TraceReturn {
+				var ret []api.Variable
+				for _, v := range bpi.Arguments {
+					if v.Flags&api.VariableReturnArgument != 0 {
+						ret = append(ret, v)
+					}
+				}
+				rec["ret"] = t.jsonVars(ret, 0)
+			} else {
+				if len(bpi.Arguments) > 0 {
+					rec["args"] = t.jsonVars(bpi.Arguments, api.VariableArgument)
+				}
+				if len(bpi.Variables) > 0 {
+					vs := []map[string]any{}
+					for i := range bpi.Variables {
+						v := t.jsonVar(&bpi.Variables[i], "")
+						v["expr"] = bpi.Variables[i].Name
+						vs = append(vs, v)
+					}
+					rec["vars"] = vs
+				}
+				if len(bpi.Locals) > 0 {
+					rec["locals"] = t.jsonVars(bpi.Locals, 0)
+				}
+				if bpi.Stacktrace != nil {
+					rec["stack"] = t.jsonFrames(bpi.Stacktrace)
+				}
+				if bpi.Goroutine != nil {
+					rec["goroutine_info"] = t.jsonGoroutine(bpi.Goroutine)
+				}
+			}
+		}
+	}
+	if len(th.ReturnValues) > 0 && (th.Breakpoint == nil || !th.Breakpoint.TraceReturn) {
+		rec["ret"] = t.jsonVars(th.ReturnValues, 0)
+	}
+	t.jsonEmit(rec)
+}
