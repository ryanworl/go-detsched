@@ -309,6 +309,21 @@ func (di *detInfo) node(bi *BinaryInfo, mem MemoryReadWriter, gaddr uint64) (nam
 	return string(buf), state
 }
 
+// detNodeStart splits the name package sim gives a node's handle, such as
+// "n2 (start 4)", into the node's name, "n2", and which start of the node
+// the handle is, 4, or 0 if the name does not say.
+func detNodeStart(handle string) (node string, start int64) {
+	i := strings.LastIndex(handle, " (start ")
+	if i < 0 || !strings.HasSuffix(handle, ")") {
+		return handle, 0
+	}
+	n, err := strconv.ParseInt(handle[i+len(" (start "):len(handle)-1], 10, 64)
+	if err != nil {
+		return handle, 0
+	}
+	return handle[:i], n
+}
+
 // DetNode returns the name of g's simulated node, "" for none, and its
 // state, "crashed" or "paused" if it is not live.
 func DetNode(t *Target, g *G) (name, state string) {
@@ -345,9 +360,13 @@ func evalDetsched(scope *EvalScope, name string) (*Variable, error) {
 	case "switches":
 		v = constant.MakeUint64(pos.Switches)
 	case "node":
-		v = constant.MakeString(pos.Node)
+		node, _ := detNodeStart(pos.Node)
+		v = constant.MakeString(node)
+	case "start":
+		_, start := detNodeStart(pos.Node)
+		v = constant.MakeInt64(start)
 	default:
-		return nil, fmt.Errorf("unknown detsched.%s (detsched.time, detsched.tick, detsched.switches and detsched.node are known)", name)
+		return nil, fmt.Errorf("unknown detsched.%s (detsched.time, detsched.tick, detsched.switches, detsched.node and detsched.start are known)", name)
 	}
 	return newConstant(v, scope.BinInfo, scope.Mem), nil
 }
