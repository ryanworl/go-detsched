pkg/proc, pkg/terminal: module data of register variables; tracepoint stacks once

Delve 1.27.2 loads the runtime's module data, which it needs to name the
dynamic type of an interface, through the memory of the variable it is
printing. For a variable held in registers, such as an argument of struct
type, that memory holds only the variable, so printing an interface field
of it failed with "error loading module data: read out of bounds" until
some interface in memory had been printed. Read the process's memory.

It also printed the stack of a tracepoint with an "on NAME stack" command
twice on each hit: printBreakpointInfo prints it, and printTracepoint
printed it again for any breakpoint without return values. Print it there
only for the breakpoints on a function's returns.

Both are generic fixes for upstream Delve.

diff --git a/pkg/proc/bininfo.go b/pkg/proc/bininfo.go
index 502ca9b..3722f87 100644
--- a/pkg/proc/bininfo.go
+++ b/pkg/proc/bininfo.go
@@ -1564,6 +1564,11 @@ func (bi *BinaryInfo) parseDebugFrameGeneral(image *Image, debugFrameBytes []byt
 }
 
 func (bi *BinaryInfo) getModuleData(mem MemoryReadWriter) ([]ModuleData, error) {
+	// The memory of a variable held in registers, such as an argument,
+	// holds only that variable, not runtime.firstmoduledata.
+	if cm, ok := mem.(*compositeMemory); ok {
+		mem = cm.realmem
+	}
 	if bi.moduleDataCache == nil {
 		var err error
 		bi.moduleDataCache, err = LoadModuleData(bi, mem)
diff --git a/pkg/terminal/command.go b/pkg/terminal/command.go
index 8f4282c..718dd13 100644
--- a/pkg/terminal/command.go
+++ b/pkg/terminal/command.go
@@ -3095,7 +3095,8 @@ func printTracepoint(t *Term, th *api.Thread, bpname string, fn *api.Function, a
 		// As of now traceFollowCalls and Stacktrace are mutually exclusive options
 		return
 	}
-	if th.Breakpoint.TraceReturn || !hasReturnValue {
+	// printBreakpointInfo printed a tracepoint's stack already.
+	if th.Breakpoint.TraceReturn && !th.Breakpoint.Tracepoint {
 		if th.BreakpointInfo != nil && th.BreakpointInfo.Stacktrace != nil {
 			fmt.Fprintf(t.stdout, "\tStack:\n")
 			printStack(t, t.stdout, th.BreakpointInfo.Stacktrace, "\t\t", false)
