diff --git a/pkg/gobuild/gobuild.go b/pkg/gobuild/gobuild.go
index c81618c..1dfd3ea 100644
--- a/pkg/gobuild/gobuild.go
+++ b/pkg/gobuild/gobuild.go
@@ -143,6 +143,11 @@ func gocommandExecCmd(command string, args ...string) (string, *exec.Cmd) {
 	allargs := []string{command}
 	allargs = append(allargs, args...)
 	goBuild := exec.Command("go", allargs...)
+	if os.Getenv("CGO_CFLAGS") == "" {
+		// Cgo code without optimizations, for the debugger; only in the
+		// build's environment, not in the one of the program dlv starts.
+		goBuild.Env = append(os.Environ(), "CGO_CFLAGS=-O0 -g")
+	}
