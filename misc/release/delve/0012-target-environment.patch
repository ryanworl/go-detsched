 // disableAck disables protocol acks.
+// launch asks the stub to launch the program argv with the A packet, and
+// whether it did with qLaunchSuccess.
+func (conn *gdbConn) launch(argv []string) error {
+	cmd := []byte("$A")
+	for i, arg := range argv {
+		if i > 0 {
+			cmd = append(cmd, ',')
+		}
+		h := hex.EncodeToString([]byte(arg))
+		cmd = fmt.Appendf(cmd, "%d,%d,%s", len(h), i, h)
+	}
+	if _, err := conn.exec(cmd, "init/launch"); err != nil {
+		return fmt.Errorf("could not launch %s: %v", argv[0], err)
+	}
+	resp, err := conn.exec([]byte("$qLaunchSuccess"), "init/launch")
+	if err != nil {
+		return fmt.Errorf("could not launch %s: %v", argv[0], err)
+	}
+	if string(resp) != "OK" {
+		return fmt.Errorf("could not launch %s: %s", argv[0], resp)
+	}
+	return nil
+}
+
