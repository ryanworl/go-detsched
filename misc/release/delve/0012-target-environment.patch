diff --git a/pkg/proc/detsched.go b/pkg/proc/detsched.go
index f5154c2..b2d88f4 100644
--- a/pkg/proc/detsched.go
+++ b/pkg/proc/detsched.go
@@ -24,6 +24,8 @@ package proc
 // and calls runtime.detDebugWatch at the count the debugger asked for.
 
 import (
+	"debug/elf"
+	"debug/macho"
 	"encoding/binary"
 	"errors"
 	"fmt"
@@ -478,3 +480,29 @@ func le64(n uint64) []byte {
 	binary.LittleEndian.PutUint64(b, n)
 	return b
 }
+
+// IsDetschedExecutable reports whether the executable at path was built
+// with GOEXPERIMENT=detsched, before it runs, from its symbol table.
+func IsDetschedExecutable(path string) bool {
+	var syms []string
+	if f, err := macho.Open(path); err == nil {
+		defer f.Close()
+		if f.Symtab != nil {
+			for _, s := range f.Symtab.Syms {
+				syms = append(syms, s.Name)
+			}
+		}
+	} else if f, err := elf.Open(path); err == nil {
+		defer f.Close()
+		ss, _ := f.Symbols()
+		for _, s := range ss {
+			syms = append(syms, s.Name)
+		}
+	}
+	for _, s := range syms {
+		if s == "runtime.detDebugStop" || s == "_runtime.detDebugStop" {
+			return true
+		}
+	}
+	return false
+}
