 	"time"
 
 	"github.com/go-delve/delve/service/api"
@@ -26,6 +27,34 @@ func posSuffix(th *api.Thread) string {
 // program: a checkpoint, or a point as of GODETSTOP.
 var detPositionRegexp = regexp.MustCompile(`^(c[0-9]+|t[0-9]*\.?[0-9]+|[sk][0-9]+)$`)
 
+// detRestartTarget returns the position restart args runs a detsched
+// program again to: args itself if it is a position, or the checkpoint
+// whose note args is. Other arguments are refused rather than taken as the
+// program's new arguments, which would run another program than the
+// replay, without its redirects.
+func (t *Term) detRestartTarget(args string) (string, error) {
+	if detPositionRegexp.MatchString(args) {
+		return args, nil
+	}
+	cps, err := t.client.ListCheckpoints()
+	if err != nil {
+		return "", err
+	}
+	var ids []string
+	for _, cp := range cps {
+		if cp.Where == args {
+			ids = append(ids, fmt.Sprintf("c%d", cp.ID))
+		}
+	}
+	switch len(ids) {
+	case 1:
+		return ids[0], nil
+	case 0:
+		return "", fmt.Errorf("restart %s: not a checkpoint's note or a position; restart takes cN, a checkpoint's note (see checkpoints), tD, sN or kN, or nothing to run the program again from its start (to run it with other arguments, start dlv again)", args)
+	}
+	return "", fmt.Errorf("restart %s: the checkpoints %s have this note; restart one by its ID", args, strings.Join(ids, ", "))
+}
+
 // isDetsched reports whether the target is a detsched program, whose
 // stops have a position, also once it exited.
 func (t *Term) isDetsched() bool {
@@ -204,3 +233,38 @@ func (t *Term) jsonFilteredVariables(kind string, vars []api.Variable, filter st
 	t.jsonEmit(map[string]any{"event": kind, "vars": t.jsonVars(match, 0)})
 	return nil
 }
+
+// instantiation is a function a breakpoint has addresses in.
+type instantiation struct {
+	name    string // with its type arguments
+	addrs   []uint64
+	wrapper bool // calls the go.shape body of another
+}
+
+// breakpointInstantiations returns the functions bp's addresses are in,
+// with their type arguments, when they are one function or the
+// instantiations of one generic function, such as a method's wrapper,
+// (*T[string]).M, and its body, (*T[go.shape.string]).M, which
+// bp.FunctionName names alike without them; nil otherwise.
+func breakpointInstantiations(bp *api.Breakpoint) []instantiation {
+	if bp.FunctionName == "" || bp.FunctionName == "(multiple functions)" || len(bp.Funcs) != len(bp.Addrs) {
+		return nil
+	}
+	var fns []instantiation
+	shape := false
+outer:
+	for i, name := range bp.Funcs {
+		shape = shape || strings.Contains(name, "go.shape.")
+		for j := range fns {
+			if fns[j].name == name {
+				fns[j].addrs = append(fns[j].addrs, bp.Addrs[i])
+				continue outer
+			}
+		}
+		fns = append(fns, instantiation{name: name, addrs: []uint64{bp.Addrs[i]}})
+	}
+	for i := range fns {
+		fns[i].wrapper = len(fns) > 1 && shape && strings.Contains(fns[i].name, "[") && !strings.Contains(fns[i].name, "go.shape.")
+	}
+	return fns
+}
