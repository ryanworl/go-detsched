+// breakpointInlined sets th.Inlined, for a thread stopped at a breakpoint
+// set on a function where calls were inlined into it or into each other,
+// to the call of the function the breakpoint was set on rather than the
+// innermost call (nil if that is the function the calls were inlined
+// into), and File and Line to where that call is. It returns the stack
+// from that call, or nil if the innermost call is the one.
+func (d *Debugger) breakpointInlined(tgt *proc.Target, thread proc.Thread, th *api.Thread) []proc.Stackframe {
+	lbp := d.target.LogicalBreakpoints[th.Breakpoint.ID]
+	if lbp == nil || lbp.Set.ExprString == "" {
+		return nil
+	}
+	loc, err := locspec.Parse(lbp.Set.ExprString)
+	if err != nil {
+		return nil
+	}
+	spec, ok := loc.(*locspec.NormalLocationSpec)
+	if !ok || spec.FuncBase == nil || spec.LineOffset >= 0 {
+		return nil
+	}
+	const maxInlined = 16
+	frames, err := proc.ThreadStacktrace(tgt, thread, maxInlined)
+	if err != nil {
+		return nil
+	}
+	bi := tgt.BinInfo()
+	// The calls inlined at the PC, innermost first, and the function they
+	// were inlined into.
+	for i := 1; i < len(frames) && frames[i-1].Inlined; i++ {
+		if frames[i].Call.Fn == nil || !spec.FuncBase.Match(frames[i].Call.Fn, bi.PackageMap) {
+			continue
+		}
+		th.Inlined = nil
+		if frames[i].Inlined {
+			th.Inlined = api.ConvertFunction(frames[i].Call.Fn)
+		}
+		th.File, th.Line = frames[i].Call.File, frames[i].Call.Line
+		return frames[i:]
+	}
+	return nil
+}
