+// printSkippedAddrs says which of the addresses found for bp other
+// breakpoints have, so that bp does not stop at them: two functions share
+// an address when one is inlined into the other at its first statement.
+func (t *Term) printSkippedAddrs(bp *api.Breakpoint, pcs []uint64) {
+	var skipped []uint64
+	for _, pc := range pcs {
+		if !slices.Contains(bp.Addrs, pc) {
+			skipped = append(skipped, pc)
+		}
+	}
+	if len(skipped) == 0 || bp.RuntimeCounted {
+		return
+	}
+	bps, err := t.client.ListBreakpoints(false)
+	if err != nil {
+		return
+	}
+	for _, pc := range skipped {
+		for _, o := range bps {
+			if o.ID == bp.ID || !slices.Contains(o.Addrs, pc) {
+				continue
+			}
+			fmt.Fprintf(t.stdout, "\t%s does not stop at %#x, which %s has: an address stops for one breakpoint, and the stack at its stops shows every call inlined there\n",
+				formatBreakpointName(bp, false), pc, formatBreakpointName(o, false))
+			break
+		}
+	}
+}
+
+// traceName returns the name of the tracepoint bp stops at the returns
+// of, or "" if it has none: return lines and records carry their
+// tracepoint's name, so that a filter on it sees both.
+func (t *Term) traceName(bp *api.Breakpoint) string {
+	if bp.TraceReturnOf == 0 {
+		return ""
+	}
+	if n, ok := t.traceNames[bp.TraceReturnOf]; ok {
+		return n
+	}
+	n := ""
+	if tp, err := t.client.GetBreakpoint(bp.TraceReturnOf); err == nil {
+		n = tp.Name
+	}
+	if t.traceNames == nil {
+		t.traceNames = map[int]string{}
+	}
+	t.traceNames[bp.TraceReturnOf] = n
+	return n
+}
