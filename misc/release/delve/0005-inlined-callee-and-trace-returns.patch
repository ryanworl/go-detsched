index 0000000..d47af1a
--- /dev/null
+++ b/pkg/proc/tracereturn.go
@@ -0,0 +1,72 @@
+package proc
+
+// The returns of a traced function follow the condition of its
+// tracepoint: a breakpoint on the function's returns, linked to the
+// tracepoint with SetTraceEntry, stops only at the return of a call whose
+// entry the tracepoint stopped at. Calls are told apart by goroutine and
+// frame (its canonical frame address), so that recursive calls and calls
+// on many goroutines pair up.
+
+// traceCall is a call of a traced function: its goroutine (0 on a
+// system stack, or before the runtime set up goroutines) and frame.
+type traceCall struct {
+	goid int64
+	cfa  int64
+}
+
+// SetTraceEntry makes lbp, a breakpoint on the returns of a function,
+// stop only at the returns of the calls whose entry the tracepoint entry
+// stopped at.
+func (lbp *LogicalBreakpoint) SetTraceEntry(entry *LogicalBreakpoint) {
+	lbp.TraceReturnOf = entry.LogicalID
+	lbp.traceEntry = entry
+	if entry.traceCalls == nil {
+		entry.traceCalls = map[traceCall]bool{}
+	}
+}
+
+// traceCallOf returns the call that thread, stopped at a breakpoint of a
+// function's entry or return, is in, and whether it is in the function
+// itself rather than in a copy inlined into another, whose returns no
+// breakpoint stops at.
+func traceCallOf(tgt *Target, thread Thread) (traceCall, bool) {
+	frames, err := ThreadStacktrace(tgt, thread, 0)
+	if err != nil || len(frames) == 0 || frames[0].Inlined {
+		return traceCall{}, false
+	}
+	c := traceCall{cfa: frames[0].Regs.CFA}
+	if g, err := GetG(thread); err == nil && g != nil {
+		c.goid = g.ID
+	}
+	return c, true
+}
+
+// traceEntered records whether the tracepoint lbp stopped at the entry of
+// the call thread is in. A call whose entry did not stop also replaces
+// what an earlier call in the same frame left, such as one that never
+// returned because it panicked.
+func (lbp *LogicalBreakpoint) traceEntered(tgt *Target, thread Thread, stopped bool) {
+	if lbp == nil || lbp.traceCalls == nil {
+		return
+	}
+	if c, ok := traceCallOf(tgt, thread); ok {
+		lbp.traceCalls[c] = stopped
+	}
+}
+
+// traceReturned reports whether lbp, a breakpoint on a function's
+// returns, stops at the return thread is at: whether the tracepoint it
+// belongs to stopped at the call's entry.
+func (lbp *LogicalBreakpoint) traceReturned(tgt *Target, thread Thread) bool {
+	entry := lbp.traceEntry
+	if entry == nil || entry.traceCalls == nil {
+		return true
+	}
+	c, ok := traceCallOf(tgt, thread)
+	if !ok {
+		return true
+	}
+	stopped := entry.traceCalls[c]
+	delete(entry.traceCalls, c)
+	return stopped
+}
