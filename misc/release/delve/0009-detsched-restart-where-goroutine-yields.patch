+// detSayYields says, when restart stopped at a position where its
+// goroutine yields, so that the program stays in the runtime, which frame
+// is the goroutine's code.
+func (t *Term) detSayYields(state *api.DebuggerState) {
+	th := state.CurrentThread
+	if th == nil || th.Function == nil || th.Function.Name() != "runtime.detDebugStop" {
+		return
+	}
+	stack, err := t.client.Stacktrace(th.GoroutineID, 8, 0, 0, nil)
+	if err != nil {
+		return
+	}
+	for i := 0; i+1 < len(stack); i++ {
+		if stack[i].Function != nil && stack[i].Function.Name() == "runtime.detPreempt" {
+			f := &stack[i+1]
+			t.detSay(fmt.Sprintf("goroutine %d yields here, at the last tick of its quantum, so its code goes on only at a later switch; frame %d is its code: %s() %s:%d", th.GoroutineID, i+1, f.Function.Name(), t.formatPath(f.File), f.Line))
+			return
+		}
+	}
+}
+
 // detExitTimeout bounds the run to the end that exit makes.
 var detExitTimeout = 5 * time.Minute
 
