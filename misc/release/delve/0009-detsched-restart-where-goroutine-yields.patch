+// DetStopYields reports whether the goroutine stopped at runtime.detDebugStop
+// yields there, at the last tick of its quantum: its code goes on only
+// after other goroutines ran, at a later switch. A runtime that does not
+// say reports false.
+func (t *Target) DetStopYields() bool {
+	di := t.detInfo()
+	if di == nil || di.yields < 0 {
+		return false
+	}
+	var b [1]byte
+	if _, err := t.Memory().ReadMemory(b[:], di.debug+uint64(di.yields)); err != nil {
+		return false
+	}
+	return b[0] != 0
+}
